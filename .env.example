# Google OAuth credentials embedded into distributed builds.
#
# Create one OAuth 2.0 client of type "Desktop app" in Google Cloud Console,
# enable the Gmail API + Google Calendar API, and paste the values below.
# Copy this file to `.env` (which is gitignored) before running `npm run tauri build`.
#
# Per Google's OAuth policy the secret of an installed/desktop app is NOT
# confidential, so shipping it in the binary is expected and safe.
#
# When these are unset, the login screen falls back to manual credential entry.

VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_SECRET=

# Lemon Squeezy buy-once licensing.
# Create a product with license keys enabled, then set the store/product IDs so
# activation verifies a key belongs to THIS product. VITE_BUY_URL is the public
# checkout/landing URL the in-app "Buy" buttons open. All optional: when unset,
# licensing still works (activation just skips the store/product check) and Buy
# buttons fall back to https://fumi.app.
VITE_LEMONSQUEEZY_STORE_ID=
VITE_LEMONSQUEEZY_PRODUCT_ID=
VITE_BUY_URL=
